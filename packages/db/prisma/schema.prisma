generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  MEMBER
  ADMIN
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum RoundStatus {
  DRAFT
  PUBLISHED
  DONE
}

enum MatchStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum Team {
  A
  B
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  UNKNOWN
}

enum SlotSource {
  CRAWLER
  MANUAL
}

enum CrawlStatus {
  RUNNING
  OK
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  phone         String?
  image         String?
  role          Role           @default(MEMBER)
  skillLevel    Int            @default(5)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  matchPlayers  MatchPlayer[]
  eventsCreated Event[]        @relation("EventCreatedBy")
}

model Venue {
  id         String      @id @default(cuid())
  name       String
  address    String?
  mapUrl     String?
  bookingUrl String?
  crawlerKey String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  courts     Court[]
  slots      CourtSlot[]
  crawlRuns  CrawlRun[]
  events     Event[]
}

model Court {
  id        String      @id @default(cuid())
  venueId   String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  venue     Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  slots     CourtSlot[]

  @@unique([venueId, name])
}

model CourtSlot {
  id         String     @id @default(cuid())
  venueId    String
  courtId    String?
  courtLabel String
  startsAt   DateTime
  endsAt     DateTime
  status     SlotStatus @default(AVAILABLE)
  price      Int?
  source     SlotSource
  fetchedAt  DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  venue      Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court      Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)

  @@unique([venueId, courtLabel, startsAt])
  @@index([venueId, startsAt])
}

model CrawlRun {
  id         String      @id @default(cuid())
  venueId    String
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  status     CrawlStatus @default(RUNNING)
  slotsFound Int         @default(0)
  error      String?
  venue      Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startedAt])
}

model Event {
  id                   String         @id @default(cuid())
  title                String
  venueId              String?
  startsAt             DateTime
  endsAt               DateTime
  courtCount           Int
  maxPlayers           Int
  registrationDeadline DateTime
  status               EventStatus    @default(DRAFT)
  notes                String?
  createdById          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  venue                Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  createdBy            User?          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registrations        Registration[]
  rounds               Round[]

  @@index([startsAt])
}

model Registration {
  id           String             @id @default(cuid())
  eventId      String
  userId       String
  status       RegistrationStatus
  registeredAt DateTime           @default(now())
  checkedInAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model Round {
  id        String      @id @default(cuid())
  eventId   String
  number    Int
  status    RoundStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches   Match[]

  @@unique([eventId, number])
}

model Match {
  id            String        @id @default(cuid())
  roundId       String
  courtNumber   Int
  status        MatchStatus   @default(SCHEDULED)
  scoreA        Int?
  scoreB        Int?
  editedByAdmin Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  round         Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  players       MatchPlayer[]

  @@unique([roundId, courtNumber])
}

model MatchPlayer {
  matchId     String
  userId      String
  team        Team
  skillAtTime Int
  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
}
