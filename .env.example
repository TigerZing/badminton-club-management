# Postgres. On Vercel + Neon these two are filled in by the Neon integration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/badminton?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/badminton?schema=public"

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=""

# First admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Club Admin"

# Optional: lets admins press "Run crawl now" (fine-grained token with Actions: write on this repo)
GITHUB_TOKEN=""
GITHUB_REPO="owner/repo"
